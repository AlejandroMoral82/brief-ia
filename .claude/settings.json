{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-Content *.env*)",
      "Edit(data/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Edit(.github/**)",
      "Bash(rm *)",
      "Bash(python -m pipeline.build)",
      "PowerShell(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(python -m pipeline.build)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(git status*)",
      "Bash(git diff*)"
    ]
  }
}
